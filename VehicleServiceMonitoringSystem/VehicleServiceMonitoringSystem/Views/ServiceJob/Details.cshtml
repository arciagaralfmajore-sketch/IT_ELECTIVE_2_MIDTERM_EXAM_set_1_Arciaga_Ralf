@model VehicleServiceMonitoringSystem.Models.ServiceJob

@{
    ViewData["Title"] = "Service Details";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>Service Details</h2>
            <p class="text-muted mb-0">
                Complete information about this service job.
            </p>
        </div>

        <span class="badge
            @(Model.Status == "Released"
                  ? "bg-success"
                  : Model.Status == "Ready for Release"
                      ? "bg-warning text-dark"
                      : Model.Status == "In Service"
                          ? "bg-primary"
                          : "bg-secondary") fs-6">

            @Model.Status

        </span>

    </div>

    <div class="card shadow-sm">

        <div class="card-body p-4">

            <!-- SERVICE INFORMATION -->

            <h5 class="mb-3">
                Service Information
            </h5>

            <div class="row mb-3">

                <div class="col-md-6">

                    <strong>Service Number</strong>

                    <p class="text-muted">
                        @Model.ServiceNumber
                    </p>

                </div>

                <div class="col-md-6">

                    <strong>Service Type</strong>

                    <p class="text-muted">
                        @Model.ServiceType
                    </p>

                </div>

            </div>

            <div class="row mb-3">

                <div class="col-md-6">

                    <strong>Service Bay</strong>

                    <p class="text-muted">
                        @Model.ServiceBay
                    </p>

                </div>

                <div class="col-md-6">

                    <strong>Status</strong>

                    <p class="text-muted">
                        @Model.Status
                    </p>

                </div>

            </div>

            <hr />

            <!-- CUSTOMER INFORMATION -->

            <h5 class="mb-3">
                Customer Information
            </h5>

            <div class="row mb-3">

                <div class="col-md-6">

                    <strong>Customer Name</strong>

                    <p class="text-muted">
                        @Model.CustomerName
                    </p>

                </div>

                <div class="col-md-6">

                    <strong>Contact Number</strong>

                    <p class="text-muted">
                        @Model.ContactNumber
                    </p>

                </div>

            </div>

            <hr />

            <!-- VEHICLE INFORMATION -->

            <h5 class="mb-3">
                Vehicle Information
            </h5>

            <div class="row mb-3">

                <div class="col-md-4">

                    <strong>Make</strong>

                    <p class="text-muted">
                        @Model.VehicleMake
                    </p>

                </div>

                <div class="col-md-4">

                    <strong>Model</strong>

                    <p class="text-muted">
                        @Model.VehicleModel
                    </p>

                </div>

                <div class="col-md-4">

                    <strong>Model Year</strong>

                    <p class="text-muted">
                        @Model.ModelYear
                    </p>

                </div>

            </div>

            <div class="row mb-3">

                <div class="col-md-4">

                    <strong>Plate Number</strong>

                    <p class="text-muted">
                        @Model.PlateNumber
                    </p>

                </div>

                <div class="col-md-4">

                    <strong>Vehicle Color</strong>

                    <p class="text-muted">
                        @Model.VehicleColor
                    </p>

                </div>

            </div>

            <hr />

            <!-- TIME INFORMATION -->

            <h5 class="mb-3">
                Service Schedule
            </h5>

            <div class="row mb-3">

                <div class="col-md-4">

                    <strong>Check-in Date & Time</strong>

                    <p class="text-muted">
                        @Model.CheckInDateTime.ToString("MMM dd, yyyy hh:mm tt")
                    </p>

                </div>

                <div class="col-md-4">

                    <strong>Expected Release</strong>

                    <p class="text-muted">
                        @Model.ExpectedReleaseDate.ToString("MMM dd, yyyy")
                    </p>

                </div>

                <div class="col-md-4">

                    <strong>Actual Release</strong>

                    <p class="text-muted">

                        @if (Model.ActualReleaseDateTime.HasValue)
                        {
                            @Model.ActualReleaseDateTime.Value.ToString(
                                "MMM dd, yyyy hh:mm tt")
                        }
                        else
                        {
                            <span>Not yet released</span>
                        }

                    </p>

                </div>

            </div>

            <hr />

            <!-- REMARKS -->

            <h5 class="mb-3">
                Remarks
            </h5>

            <p class="text-muted">

                @if (!string.IsNullOrWhiteSpace(Model.Remarks))
                {
                    @Model.Remarks
                }
                else
                {
                    <span>No remarks.</span>
                }

            </p>

            <hr />

            <!-- ACTIONS -->

            <div class="d-flex gap-2">

                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary">

                    Edit

                </a>

                @if (Model.Status != "Released")
                {
                    <a asp-action="Release"
                       asp-route-id="@Model.Id"
                       class="btn btn-success">

                        Release Vehicle

                    </a>
                }

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Back to Monitoring

                </a>

            </div>

        </div>

    </div>

</div>