@model List<VehicleServiceMonitoringSystem.Models.ServiceJob>

@{
    ViewData["Title"] = "Service Monitoring";
}

<!-- HEADER -->
<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="fw-bold">Service Monitoring</h2>

        <p class="text-muted mb-0">
            Monitor customer vehicles from check-in until release.
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-primary">

        Register Vehicle

    </a>

</div>


<!-- SEARCH -->
<form asp-action="Index"
      method="get"
      class="mb-4">

    <div class="input-group">

        <input type="text"
               name="search"
               value="@ViewBag.Search"
               class="form-control"
               placeholder="Search service number, customer, plate, or vehicle..." />

        <button type="submit"
                class="btn btn-outline-primary">

            Search

        </button>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            Clear

        </a>

    </div>

</form>


<!-- MONITORING TABLE -->
<div class="card shadow-sm">

    <div class="card-header bg-primary text-white">

        <h5 class="mb-0">
            Service Jobs
        </h5>

    </div>

    <div class="card-body">

        @if (!Model.Any())
        {
            <div class="text-center py-5">

                <h5>
                    No service jobs found.
                </h5>

                <p class="text-muted">
                    Register a vehicle to begin monitoring service jobs.
                </p>

                <a asp-action="Create"
                   class="btn btn-primary">

                    Register Vehicle

                </a>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-dark">

                        <tr>

                            <th>Service No.</th>

                            <th>Customer</th>

                            <th>Vehicle</th>

                            <th>Plate Number</th>

                            <th>Service Type</th>

                            <th>Service Bay</th>

                            <th>Check-in Time</th>

                            <th>Release Time</th>

                            <th>Status</th>

                            <th>Actions</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var job in Model)
                        {
                            <tr>

                                <!-- SERVICE NUMBER -->

                                <td>
                                    <strong>
                                        @job.ServiceNumber
                                    </strong>
                                </td>


                                <!-- CUSTOMER -->

                                <td>
                                    @job.CustomerName
                                </td>


                                <!-- VEHICLE -->

                                <td>
                                    @job.VehicleMake
                                    @job.VehicleModel
                                </td>


                                <!-- PLATE -->

                                <td>
                                    <span class="fw-semibold">
                                        @job.PlateNumber
                                    </span>
                                </td>


                                <!-- SERVICE TYPE -->

                                <td>
                                    @job.ServiceType
                                </td>


                                <!-- SERVICE BAY -->

                                <td>
                                    @job.ServiceBay
                                </td>


                                <!-- CHECK-IN TIME -->

                                <td>

                                    @job.CheckInDateTime.ToString(
                                        "MMM dd, yyyy hh:mm tt")

                                </td>


                                <!-- RELEASE TIME -->

                                <td>

                                    @if (job.ActualReleaseDateTime.HasValue)
                                    {
                                        @job.ActualReleaseDateTime.Value.ToString(
                                            "MMM dd, yyyy hh:mm tt")
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }

                                </td>


                                <!-- STATUS -->

                                <td>

                                    @if (job.Status == "Waiting")
                                    {
                                        <span class="badge bg-secondary">
                                            Waiting
                                        </span>
                                    }
                                    else if (job.Status == "In Service")
                                    {
                                        <span class="badge bg-primary">
                                            In Service
                                        </span>
                                    }
                                    else if (job.Status == "Ready for Release")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Ready for Release
                                        </span>
                                    }
                                    else if (job.Status == "Released")
                                    {
                                        <span class="badge bg-success">
                                            Released
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-dark">
                                            @job.Status
                                        </span>
                                    }

                                </td>


                                <!-- ACTIONS -->

                                <td>

                                    <div class="btn-group btn-group-sm">

                                        <!-- DETAILS -->

                                        <a asp-action="Details"
                                           asp-route-id="@job.Id"
                                           class="btn btn-outline-info">

                                            Details

                                        </a>


                                        <!-- EDIT -->

                                        <a asp-action="Edit"
                                           asp-route-id="@job.Id"
                                           class="btn btn-outline-primary">

                                            Edit

                                        </a>


                                        <!-- RELEASE -->
                                        @if (job.Status != "Released")
                                        {
                                            <a asp-action="Release"
                                               asp-route-id="@job.Id"
                                               class="btn btn-outline-success">

                                                Release

                                            </a>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>