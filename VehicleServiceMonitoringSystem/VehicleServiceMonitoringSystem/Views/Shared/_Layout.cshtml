<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Vehicle Service Monitoring System
    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

</head>

<body>

    <header>

        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">

            <div class="container">

                <a class="navbar-brand fw-bold"
                   asp-controller="ServiceJob"
                   asp-action="Index">

                    Vehicle Service Monitoring

                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse"
                     id="mainNavbar">

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <ul class="navbar-nav me-auto">

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="ServiceJob"
                                   asp-action="Index">

                                    Service Monitoring

                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="ServiceJob"
                                   asp-action="Create">

                                    Register Vehicle

                                </a>

                            </li>

                        </ul>

                        <ul class="navbar-nav">

                            <li class="nav-item">

                                <span class="navbar-text text-white me-3">

                                    Welcome,
                                    <strong>
                                        @User.Identity.Name
                                    </strong>

                                </span>

                            </li>

                            <li class="nav-item">

                                <form asp-controller="Account"
                                      asp-action="Logout"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="nav-link btn btn-link text-white border-0">

                                        Logout

                                    </button>

                                </form>

                            </li>

                        </ul>
                    }
                    else
                    {
                        <ul class="navbar-nav me-auto">

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Account"
                                   asp-action="Login">

                                    Login

                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Account"
                                   asp-action="Register">

                                    Register

                                </a>

                            </li>

                        </ul>
                    }

                </div>

            </div>

        </nav>

    </header>


    <main class="container py-4">

        @RenderBody()

    </main>


    <footer class="border-top footer text-muted">

        <div class="container py-3">

            &copy; 2026 -
            Vehicle Service Monitoring System

        </div>

    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync(
        "Scripts",
        required: false)

</body>

</html>